# Databases
JWT_SECRET="aa368ab2bd4740e3db2f636e5469274062490f7a2841860b20bbaa53c911b53104e64732958d70c377777f5a18fc9f3e744f59fdd52a231b21f7979ac642c745"
GEMINI_API_KEY="use-your-gemini-api-key-from-aistudio.google.coù"
PORT=3300

#Local databases
# --------- N'oubliez pas de changer les paramètres de cet url ----------
LOCAL_DB_URL="postgresql://database_owner:password@localhost:5432/database_name?schema=public"

# Semantic search variables
SEMANTIC_MIN_SIMILARITY=0.55
SEMANTIC_MAX_GAP=0.06

# ───────── Thésaurus (routage multi-thésaurus) ─────────
# Langue des libellés pour tous les thésaurus (prioritaire sur UNESCO_LANG)
THESAURUS_LANG=fr

# UNESCO (Skosmos) — les UNESCO_* ci-dessus sont toujours lues,
# les THESAURUS_UNESCO_* ne servent que si tu veux les remplacer
THESAURUS_UNESCO_URL=https://vocabularies.unesco.org/rest/v1
THESAURUS_UNESCO_VOCAB_ID=unesco
THESAURUS_UNESCO_TIMEOUT_MS=3000

# AGROVOC (Skosmos, FAO)
THESAURUS_AGROVOC_URL=https://agrovoc.fao.org/browse/rest/v1
THESAURUS_AGROVOC_VOCAB_ID=agrovoc
THESAURUS_AGROVOC_TIMEOUT_MS=3000

# MeSH français (Skosmos, Loterre / Inist-CNRS)
THESAURUS_MESH_URL=https://loterre.istex.fr/rest/v1
THESAURUS_MESH_VOCAB_ID=JVR
THESAURUS_MESH_TIMEOUT_MS=3000

# Eurovoc (SPARQL, Publications Office de l'UE)
THESAURUS_EUROVOC_URL=https://publications.europa.eu/webapi/rdf/sparql
THESAURUS_EUROVOC_TIMEOUT_MS=6000

# RAMEAU (SPARQL, data.bnf.fr)
THESAURUS_RAMEAU_URL=https://data.bnf.fr/sparql
THESAURUS_RAMEAU_TIMEOUT_MS=6000

# Getty AAT (SPARQL)
THESAURUS_GETTY_AAT_URL=https://vocab.getty.edu/sparql.json
THESAURUS_GETTY_AAT_TIMEOUT_MS=6000

#Gmail
GMAIL_USER=your-gmail-with-2FA-activated-and-contains-app-pswd
GMAIL_APP_PASSWORD=your-app-pswd-from-gmail

#UI Urls
FRONTEND_URL=http://localhost:3100
